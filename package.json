{
  "name": "grammar-checker",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/core",
    "apps/chrome",
    "apps/settings-web",
    "packages/protocol"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "test:models": "bun run --cwd apps/core test:models",
    "test:keychain": "bun run --cwd apps/core test:keychain",
    "build:chrome": "bun run --cwd apps/chrome build",
    "build:settings": "bun run --cwd apps/settings-web build",
    "settings": "bun run --cwd apps/core cli settings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
