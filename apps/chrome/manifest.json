{
  "manifest_version": 3,
  "name": "Grammar Checker",
  "version": "0.1.0",
  "description": "Grammar and spelling checks in English and French, using a local core.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}
